---
import Link from "./Link.astro"
---

<div class="bg-[#E5E5E5] flex flex-col gap-[20px] px-[20px] py-[16px] w-[100%]">
  <div class="flex flex-row justify-between">
    <div class="inline-flex flex-col justify-center items-start gap-7 overflow-hidden">
      <ul class="list-disc list-inside flex flex-col gap-[30px]">
        <li class="p2">Virksomheden</li>
        <li class="p2">Service</li>
        <li class="p2">Information</li>
      </ul>
    </div>
    <div class="px-[11px] inline-flex justify-center items-center gap-[15px] flex-col self-center overflow-hidden">
      <div class="place-self-center s1">Social Media</div>
      <div class="flex flex-row gap-3">
        <a class="md:hover:animate-heartbeat" href="https://www.figma.com/proto/9JrNnAUSmKHHvxlZLQW4mv/Instagram-Prototype?node-id=2-171&viewport=-67%2C133%2C0.25&t=Q73WlZCtfBqe9aeq-1&scaling=scale-down&content-scaling=fixed&starting-point-node-id=2%3A171&page-id=0%3A1"><div><img class="w-10 lg:w-10" src="/images/some-icons/Linkedin.svg" alt="" /></div></a>
        <a class="md:hover:animate-heartbeat" href="https://www.figma.com/proto/9JrNnAUSmKHHvxlZLQW4mv/Instagram-Prototype?node-id=2-171&viewport=-67%2C133%2C0.25&t=Q73WlZCtfBqe9aeq-1&scaling=scale-down&content-scaling=fixed&starting-point-node-id=2%3A171&page-id=0%3A1"><div><img class="w-10 lg:w-10" src="/images/some-icons/Instagram.svg" alt="" /></div></a>
        <a class="md:hover:animate-heartbeat" href="https://www.figma.com/proto/9JrNnAUSmKHHvxlZLQW4mv/Instagram-Prototype?node-id=2-171&viewport=-67%2C133%2C0.25&t=Q73WlZCtfBqe9aeq-1&scaling=scale-down&content-scaling=fixed&starting-point-node-id=2%3A171&page-id=0%3A1"><div><img class="w-10 lg:w-10" src="/images/some-icons/Facebook.svg" alt="" /></div></a>
      </div>
    </div> 
  </div>
  <div>
    <div data-layer="logo 1" class="Logo1 w-[100%] self-stretch p-[5px] bg-linear-270 from-red-800 to-red-700 inline-flex flex-row justify-end items-center gap-2.5 overflow-hidden">
      <img class="Logo2" src="/images/ecomanager-logo.png" />
      <img class="Logo2 w-24 h-4" src="/images/logo.png" />
    </div>
  </div>
  <div class="">
    <p class="text-[8px]">© 2026 Zeppelin-Rental.dk - CVR 11779573 - Zeppelin Rental Danmark A/S</p>
  </div>
</div>
