            <div class="absolute -z-1 flex flex-col items-center w-[90px] h-[90px] gap-[10px] group-hover:bg-[#95C93F] rounded-[360px] blur-[0px] md:group-hover:animate-heartbeat md:group-hover:animate-duration-2000 md:group-hover:animate-iteration-count-infinite md:group-hover:animate-ease-linear">
            </div>
            <div>
